# Copie para .env só se for usar algo opcional. O .env nunca vai para o git.
# O estúdio funciona sem nenhuma chave: transcrição, voz Edge, VTEX e /watch rodam de graça.

# Voz do ElevenLabs (opcional, plano gratuito): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Transcrição rápida pelo Groq (opcional, gratuito): https://console.groq.com/keys
# Use com: node scripts/transcrever.mjs <video> <palavras.json> --groq
GROQ_API_KEY=
